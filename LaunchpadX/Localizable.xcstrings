    "The selected action permanently deletes the application. No matching data was found in your Library." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The selected action permanently deletes the application. No matching data was found in your Library." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "所选操作会永久删除应用。用户资源库中没有找到匹配数据。" } } } },
    "Choose whether to permanently delete only the app or also these exact matching data items:\n\n%@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose whether to permanently delete only the app or also these exact matching data items:\n\n%@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请选择仅永久删除应用，或同时删除以下完全匹配的数据：\n\n%@" } } } },
    "The application bundle is missing or is not a valid app path." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The application bundle is missing or is not a valid app path." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用程序包不存在或路径无效。" } } } },
    "System applications cannot be uninstalled." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "System applications cannot be uninstalled." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "系统应用不能卸载。" } } } },
    "LaunchpadX cannot uninstall itself while it is running." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "LaunchpadX cannot uninstall itself while it is running." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "LaunchpadX 正在运行，无法卸载自身。" } } } },
    "Quit %@ before uninstalling it." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Quit %@ before uninstalling it." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请先退出 %@ 再卸载。" } } } },
    "Administrator authorization failed: %@" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Administrator authorization failed: %@" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "管理员授权失败：%@" } } } },
    "Uninstall was cancelled because administrator authorization was not granted." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Uninstall was cancelled because administrator authorization was not granted." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "未获得管理员授权，已取消卸载。" } } } },
