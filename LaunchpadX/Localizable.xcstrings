    "Move selected applications to Trash?" : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "Move selected applications to Trash?" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "确定将所选应用移到废纸篓吗？" } } } },
    "The confirmation window is unavailable." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "The confirmation window is unavailable." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "无法显示确认窗口。" } } } },
    "These applications will be moved to the macOS Trash and can be restored from there. Application support data is left in place." : { "localizations" : { "en" : { "stringUnit" : { "state" : "translated", "value" : "These applications will be moved to the macOS Trash and can be restored from there. Application support data is left in place." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "这些应用会移入 macOS 废纸篓，可从废纸篓恢复。应用支持数据会保留。" } } } },
